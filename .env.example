# Environment Configuration Template
# Copy this file to .env and customize

# Application
APP_ENV=development  # development | production
DEBUG=true

# Data Paths (override config.yaml if needed)
DATA_ROOT=./data
DATABASE_URL=sqlite:///./data/knowledge.db

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Security
OFFLINE_MODE=true
ALLOW_EXTERNAL_APIS=false
# Comma-separated whitelist: search.brave.com,api.duckduckgo.com
EXTERNAL_API_WHITELIST=

# Optional: External API Keys (only if ALLOW_EXTERNAL_APIS=true)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Performance
MAX_WORKERS=4
CACHE_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features
ENABLE_GRAPH_RAG=false
ENABLE_ASR=false
ENABLE_OCR=false
